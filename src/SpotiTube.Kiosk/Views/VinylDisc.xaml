<UserControl x:Class="SpotiTube.Kiosk.Views.VinylDisc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SpotiTube.Kiosk.Views.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:ByteArrayToImageSourceConverter x:Key="AlbumArtConverter" />
    </UserControl.Resources>

    <Grid Width="260" Height="260" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="SpinRotation" Angle="0" />
        </Grid.RenderTransform>

        <!-- Disc body. Almost entirely covered by the art label below - what's left visible here is
             just the thin rim, the same way a printed "picture disc" vinyl still shows a sliver of
             black around the edge of its artwork. -->
        <Ellipse>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF3A3A3A" Offset="0" />
                    <GradientStop Color="#FF111111" Offset="0.55" />
                    <GradientStop Color="#FF050505" Offset="1" />
                </RadialGradientBrush> 
            </Ellipse.Fill>
        </Ellipse>

        <!-- Fallback label, visible whenever the album art ellipse above it has no image to show -->
        <Ellipse Width="248" Height="248" Fill="#FF2A2A2A" />
        <Path Data="{StaticResource IconMusicNote}" Width="64" Height="64" Stretch="Uniform" Fill="#FF6A6A6A" />

        <!-- Album art now covers nearly the entire disc face, not just a small center label.
             Transparent (no Source) when the current session has no artwork, letting the fallback
             label underneath show through instead. -->
        <Ellipse Width="248" Height="248">
            <Ellipse.Fill>
                <ImageBrush Stretch="UniformToFill"
                            ImageSource="{Binding AlbumArt, ElementName=Root, Converter={StaticResource AlbumArtConverter}}" />
            </Ellipse.Fill>
        </Ellipse>

        <!-- Groove rings, drawn as a subtle overlay on top of the art for texture -->
        <Ellipse Width="244" Height="244" Stroke="#14FFFFFF" StrokeThickness="1" />
        <Ellipse Width="220" Height="220" Stroke="#14FFFFFF" StrokeThickness="1" />
        <Ellipse Width="196" Height="196" Stroke="#14FFFFFF" StrokeThickness="1" />
        <Ellipse Width="172" Height="172" Stroke="#14FFFFFF" StrokeThickness="1" />
        <Ellipse Width="148" Height="148" Stroke="#14FFFFFF" StrokeThickness="1" />

        <!-- Center spindle hole, sized up a little so it still reads clearly now that art fills
             almost the whole disc -->
        <Ellipse Width="28" Height="28" Fill="#FF050505" />
    </Grid>
</UserControl>
